{
  "name": "nostrblue",
  "version": "0.7.5",
  "description": "Nostr.blue Rust client",
  "scripts": {
    "dev": "npm run git-worker:build && dx serve",
    "build": "npm run git-worker:build && dx build --release",
    "git-worker:build": "esbuild assets/js/git-worker.js --bundle --outfile=public/git-worker.js --format=esm --platform=browser --target=es2020 --minify",
    "git-worker:watch": "esbuild assets/js/git-worker.js --bundle --outfile=public/git-worker.js --format=esm --platform=browser --target=es2020 --watch",
    "build:all": "npm run git-worker:build"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "esbuild": "^0.27.2",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.36.1"
  }
}
